{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "focaldrop-web-staging",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "focaldrop-web-staging",
    },
  ],
  "vars": {
    "API_URL": "https://focaldrop-api-staging-664538226545.us-east4.run.app",
  },
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "focaldrop-web-cache-staging",
    },
  ],
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "focaldrop-web-tags-staging",
      "database_id": "00000000-0000-4000-8000-000000000001",
    },
  ],
  "observability": {
    "enabled": true,
  },
  "previews": {
    "vars": {
      "API_URL": "https://focaldrop-api-staging-664538226545.us-east4.run.app",
    },
    "services": [],
    "r2_buckets": [
      {
        "binding": "NEXT_INC_CACHE_R2_BUCKET",
        "bucket_name": "focaldrop-web-cache-preview",
      },
    ],
    "d1_databases": [
      {
        "binding": "NEXT_TAG_CACHE_D1",
        "database_name": "focaldrop-web-tags-preview",
        "database_id": "00000000-0000-4000-8000-000000000002",
      },
    ],
  },
  "env": {
    "cache-preview": {
      "vars": {
        "API_URL": "https://focaldrop-api-staging-664538226545.us-east4.run.app",
      },
      "services": [],
      "r2_buckets": [
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "focaldrop-web-cache-preview",
        },
      ],
      "d1_databases": [
        {
          "binding": "NEXT_TAG_CACHE_D1",
          "database_name": "focaldrop-web-tags-preview",
          "database_id": "00000000-0000-4000-8000-000000000002",
        },
      ],
    },
  },
}
