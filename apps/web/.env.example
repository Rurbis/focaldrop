# Supabase Auth for the admin panel (Phase 2 §4.3). Copy this file to .env.local.
# Local values come from infra/supabase/.env.local after `pnpm db:start`:
#   NEXT_PUBLIC_SUPABASE_URL             <- API_URL
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY <- PUBLISHABLE_KEY (sb_publishable_...)
# Never the secret key: the web app only uses the publishable one.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Sentry (optional, issue #22). Empty keeps it off. In CI it comes from the
# `staging` and `preview` GitHub Environments.
NEXT_PUBLIC_SENTRY_DSN=
