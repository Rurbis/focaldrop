{
  "name": "@focaldrop/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration:f1": "node scripts/verify-f1.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:local": "opennextjs-cloudflare preview",
    "cf:size": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "cf:preview": "wrangler preview"
  },
  "dependencies": {
    "@focaldrop/shared": "workspace:*",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-aria": "3.52.1",
    "react-aria-components": "1.21.1",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.12",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "vitest": "4.1.12",
    "wrangler": "4.148.0"
  }
}
