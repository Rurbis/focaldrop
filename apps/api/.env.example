# Required: development, test or production.
NODE_ENV=development

# Optional. Defaults to 3001.
PORT=3001

# Optional locally. Use the API project's DSN from Bitwarden in staging/production.
SENTRY_DSN=

# Optional. Defaults to NODE_ENV; use staging for the staging deployment.
SENTRY_ENVIRONMENT=

# Runtime role. The local seed (#15) configures its Docker-only password.
DATABASE_URL=postgresql://app_api:focaldrop_local_api@127.0.0.1:54322/postgres

# Optional fallback for unknown/missing tenant hosts; ignored with NODE_ENV=production.
DEFAULT_AGENCY_SLUG=demo

# DDL uses the local administrator; staging uses the session pooler (port 5432).
# Never use the runtime role or transaction pooler for migrations.
MIGRATIONS_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Local seed/reset only. The admin key is read from infra/supabase/.env.local.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=
