{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "agentGuidance": false,
  "globalDependencies": [
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    ".nvmrc",
    "tsconfig.base.json",
    "eslint.config.js",
    "prettier.config.js",
    ".github/workflows/ci.yml",
    ".github/actions/**"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["WEB_BUILD_ID", "API_URL"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "CI",
        "APP_ENV",
        "DATABASE_URL",
        "TEST_DATABASE_URL",
        "MIGRATIONS_DATABASE_URL",
        "DEFAULT_AGENCY_SLUG"
      ]
    },
    "dev": {
      "env": [
        "NODE_ENV",
        "APP_ENV",
        "PORT",
        "DATABASE_URL",
        "DEFAULT_AGENCY_SLUG",
        "SENTRY_DSN",
        "SENTRY_ENVIRONMENT",
        "API_URL",
        "AGENCY_CACHE_REVALIDATION_SECRET"
      ],
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
