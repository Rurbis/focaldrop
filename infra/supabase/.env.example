# Example output of the local Supabase CLI; these are not application/staging credentials.
# Generate infra/supabase/.env.local after pnpm db:start (see README.md here).
# API_URL is Supabase Auth's gateway, not the Nest API used by the web app.
API_URL=http://127.0.0.1:54321
DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
STUDIO_URL=http://127.0.0.1:54323
MAILPIT_URL=http://127.0.0.1:54324
# INBUCKET_URL is the legacy CLI alias for Mailpit.
INBUCKET_URL=http://127.0.0.1:54324
MCP_URL=http://127.0.0.1:54321/mcp

# Keep keys empty here. These local CLI keys are not staging/app configuration.
ANON_KEY=
SERVICE_ROLE_KEY=
JWT_SECRET=
PUBLISHABLE_KEY=
SECRET_KEY=
